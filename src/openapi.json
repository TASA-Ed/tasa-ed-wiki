        ],
        "summary": "获取 UA",
        "description": "获取客户端 UA",
        "operationId": "get_ua",
        "parameters": [
          {
            "name": "format",
            "in": "query",
            "description": "支持 json(application/json) text(text/html) xml(application/xml)，默认 text",
            "required": false,
            "schema": {
              "type": "string",
              "default": "text"
            },
            "example": "json"
