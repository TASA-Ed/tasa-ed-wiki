    "/v2/time": {
      "get": {
        "tags": [
          "Time"
        ],
        "summary": "获取时间",
        "description": "获取当前时间",
        "operationId": "get_time",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "description": "1: 中国时区 | 2: 秒级时间戳 | 3: 格林威治时间 | 4: 协调世界时 | 5: 上海时间 | 6: 纽约时间 | 7: 新加坡时间 | 8: 乌鲁木齐时间 | 9: 毫秒级时间戳 | 10: 自定义时区，需填写 timezone 参数",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/TimeType"
            },
            "example": 1
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "text"
            },
            "example": "json"
          },
          {
            "name": "timezone",
            "in": "query",
            "description": "在 type 为 10 时需要",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "Asia/Tokyo"
          }
        ],
        "responses": {
          "200": {
            "description": "时间。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonResponseSuccess"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/XmlResponseSuccess"
                }
              },
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonResponseError"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/XmlResponseError"
                }
              },
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
