  "paths": {
    "/v2/base64": {
      "get": {
        "tags": [
          "TextProcessing"
        ],
        "summary": "Base64",
        "description": "Base64 编码或解码",
        "operationId": "get_base",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "description": "0: 标准编码 | 1: 标准解码（容忍填充错误） | 2: `URL_SAFE` 编码 | 3: `URL_SAFE` 解码 | 4: 标准解码",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/BaseType"
            },
            "example": 0
          },
          {
            "name": "value",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "Hello"
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "text"
            },
            "example": "json"
          }
        ],
        "responses": {
          "200": {
            "description": "Base64 编码或解码后的数据。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonResponseSuccess"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/XmlResponseSuccess"
                }
              },
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonResponseError"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/XmlResponseError"
                }
              },
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "description": "解码错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonResponseError"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/XmlResponseError"
                }
              },
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/v2/hash": {
      "get": {
        "tags": [
          "TextProcessing"
        ],
        "summary": "哈希",
        "description": "Hash|哈希|散列 值计算",
        "operationId": "get_hash",
        "parameters": [
          {
            "name": "content",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "Hello"
          },
          {
            "name": "type",
            "in": "query",
            "description": "哈希类型",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/HashType"
            },
            "example": "md5"
          },
          {
            "name": "binary",
            "in": "query",
            "description": "为 1 时以 base64 输出（将哈希的二进制格式转为 base64）",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0,
              "maximum": 1,
              "minimum": 0
            },
            "example": 1
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "text"
            },
            "example": "json"
          }
        ],
        "responses": {
          "200": {
            "description": "哈希值。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonResponseSuccess"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/XmlResponseSuccess"
                }
              },
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonResponseError"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/XmlResponseError"
                }
              },
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/v2/ip": {
      "get": {
        "tags": [
          "Get"
        ],
        "summary": "获取 IP",
        "description": "获取客户端 IP 地址",
        "operationId": "get_ip",
        "parameters": [
          {
            "name": "format",
            "in": "query",
            "description": "支持 json(application/json) text(text/html) xml(application/xml)，默认 text",
            "required": false,
            "schema": {
              "type": "string",
              "default": "text"
            },
            "example": "json"
          }
        ],
        "responses": {
          "200": {
            "description": "IP 数据。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonResponseSuccess"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/XmlResponseSuccess"
                }
              },
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/v2/output": {
      "get": {
        "tags": [
          "Get"
        ],
        "summary": "输出文本",
        "description": "将输入的文本再输出",
        "operationId": "get_ot",
        "parameters": [
          {
            "name": "format",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "text"
            },
            "example": "json"
          },
          {
            "name": "ot",
            "in": "query",
            "description": "与 output 二选一，要输出的文本",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "Hello"
          },
          {
            "name": "output",
            "in": "query",
            "description": "与 ot 二选一，要输出的文本",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "Hello"
          }
        ],
        "responses": {
          "200": {
            "description": "输出文本",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonResponseSuccess"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/XmlResponseSuccess"
                }
              },
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonResponseError"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/XmlResponseError"
                }
              },
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/v2/random-word": {
      "get": {
        "tags": [
          "Get"
        ],
        "summary": "获取随机诗词",
        "description": "获取一个随机诗词",
        "operationId": "get_rw",
        "parameters": [
          {
            "name": "format",
            "in": "query",
            "description": "支持 json(application/json) text(text/html) xml(application/xml)，默认 text",
            "required": false,
            "schema": {
              "type": "string",
              "default": "text"
            },
            "example": "json"
